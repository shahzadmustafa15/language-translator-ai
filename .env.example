# Optional for local development when frontend and API are on different origins.
# In the combined Vercel deployment, the frontend uses /api directly.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Optional override for the translation backend.
# Defaults to the public MyMemory API used for demo translations.
TRANSLATION_API_URL=https://api.mymemory.translated.net/get
TRANSLATION_API_KEY=
